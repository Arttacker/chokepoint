# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------
ORIG_ARGS=("$@")
CMD="" POS=() PROFILES=() NAME_OPT="" FOLLOW=0 LIVE=0 FORCE=0 HELP=0 REUSE_STATE=0

opt_val() { (( $1 > 0 )) || die "option $2 needs a value (see: $PROG help)"; }
while (( $# )); do
  a=$1; shift
  if [[ $a == --*=* ]]; then set -- "${a#*=}" "$@"; a=${a%%=*}; fi
  case $a in
    --) POS+=("$@"); break ;;
    -h|--help) HELP=1 ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
    -p|--profile|-c|--config) opt_val $# "$a"; PROFILES+=("$1"); shift ;;
    -n|--name) opt_val $# "$a"; NAME_OPT=$1; cli_op set NAME "$1"; shift ;;
    --dry-run) DRY_RUN=1 ;;
    --force) FORCE=1 ;;
    -f|--follow) FOLLOW=1 ;;
    --live) LIVE=1 ;;
    --no-color) set_colors off ;;
    --sandbox) for _k in FIREWALL_ISOLATE_HOST FIREWALL_BLOCK_PRIVATE FIREWALL_BLOCK_DOT DNS_FORCE DNS_LOG_QUERIES; do cli_op set "$_k" true; done ;;
    --set)
      opt_val $# "$a"; _k=${1%%=*}; _val=${1#*=}; shift
      [[ $_k == "$_val" ]] && die "--set needs KEY=VALUE"
      if [[ -n ${PATH2VAR[$_k]:-} ]]; then _k=${PATH2VAR[$_k]}
      elif [[ -z ${S_PATH[${_k^^}]:-} ]]; then die "--set: unknown key '$_k' (see: $PROG help config)"
      else _k=${_k^^}; fi
      cli_op set "$_k" "$_val" ;;
    -*)
      [[ -n ${FLAGS[$a]:-} ]] || die "unknown option '$a' (see: $PROG help)"
      _act=${FLAGS[$a]%%:*}; _k=${FLAGS[$a]#*:}
      case $_act in
        true|false) cli_op set "$_k" "$_act" ;;
        *) opt_val $# "$a"; cli_op "$_act" "$_k" "$1"; shift ;;
      esac ;;
    *) if [[ -z $CMD ]]; then CMD=$a; else POS+=("$a"); fi ;;
  esac
done

if (( HELP )) || [[ -z $CMD ]]; then
  case ${CMD:-} in examples) help_examples ;; config) help_config ;; *) help_main ;; esac
  exit 0
fi

case $CMD in
  help)      case ${POS[0]:-} in examples|example|ex) help_examples ;; config|yaml|keys) help_config ;; *) help_main ;; esac ;;
  start)     need_root; cmd_start ;;
  stop)      need_root; cmd_stop ;;
  restart)   need_root; cmd_restart ;;
  status)    need_root; cmd_status ;;
  leases)    need_root; cmd_leases ;;
  clients)   need_root; cmd_clients ;;
  logs|log)  need_root; cmd_logs ;;
  top|stats) need_root; cmd_top ;;
  capture|pcap) need_root; cmd_capture ;;
  scan)      need_root; cmd_scan ;;
  block)     need_root; cmd_block ;;
  dns)       need_root; cmd_dns ;;
  reserve)   need_root; cmd_reserve ;;
  forward)   need_root; cmd_forward ;;
  client)    need_root; cmd_client ;;
  profiles)  cmd_profiles ;;
  init)      cmd_init ;;
  config)    [[ ${POS[0]:-} == running ]] && need_root; cmd_config ;;
  check|doctor) cmd_check ;;
  *) die "unknown command '$CMD' (see: $PROG help)" ;;
esac
